<script lang="php">
use Acceptance\Gate;
use Acceptance\Store;
use Crab\Psx\Action;
use Crab\Psx\ActionResult;
use Crab\Psx\Query;
use Crab\Psx\QueryData;
use Crab\Psx\Inject;

final readonly class Counted
{
    public function __construct(
        public string $box,
        public int $count,
    ) {}
}

/** @return QueryData<Counted> */
#[Query]
function read(string $box, #[Inject] Gate $gate, #[Inject] Store $store): QueryData
{
    $gate->pass('box.read', $box);
    return QueryData::of(new Counted($box, $store->count($box)))->tags("box:{$box}");
}

/** @return ActionResult<int> */
#[Action]
function add(string $box, #[Inject] Store $store): ActionResult
{
    return ActionResult::ok($store->add($box))->invalidate("box:{$box}");
}
</script>
import { useQuery } from '@crabphp/psx';
import { services } from '@psx/services';

// A component with a query and an action of its own, mounted on a path with a parameter: each
// instance is bound to its own box.
export default function Box({ box }: { box: string }) {
    const scope = services.box.scope({ box });
    const counted = useQuery($read.at(scope), {});
    return (
        <div data-testid={`box-${box}`}>
            <span data-testid={`box-${box}-count`}>
                {counted.data === undefined ? counted.status : `${counted.data.box}=${counted.data.count}`}
            </span>
            <button data-testid={`box-${box}-add`} onClick={() => void $add.at(scope)({})}>
                Add
            </button>
        </div>
    );
}
