{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "allowArbitraryExtensions": true,
        "types": ["vite/client"],
        "rootDirs": ["resources", ".psx/client"],
        "paths": {
            "@psx/*": ["./.psx/*"]
        }
    },
    "include": ["resources", ".psx/**/*.ts", ".psx/**/*.tsx"]
}
