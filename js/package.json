{
    "name": "@crabphp/psx",
    "version": "0.1.0",
    "description": "The React runtime, generated-binding support, Vite plugin, renderer and test helpers of PSX for Crab",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./bindings": {
            "types": "./dist/bindings.d.ts",
            "default": "./dist/bindings.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./ssr": {
            "types": "./dist/ssr.d.ts",
            "default": "./dist/ssr.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "default": "./dist/testing.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "format": "prettier --write src test",
        "format:check": "prettier --check src test"
    },
    "peerDependencies": {
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "vite": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "dependencies": {
        "@vitejs/plugin-react": "^6.0.0"
    },
    "devDependencies": {
        "@testing-library/react": "latest",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "jsdom": "latest",
        "prettier": "latest",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "typescript": "^7.0.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.0"
    }
}
